<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aureliadle's rules and save format, shared by the game (feliz/Aureliadle) and its tests (test2). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Words.fs" />
    <Compile Include="Phonics.fs" />
    <Compile Include="GameRules.fs" />
    <Compile Include="Daily.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="Game.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Browser.WebStorage" Version="1.3.0" />
    <PackageReference Include="Thoth.Json.Core" Version="0.9.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true'">
    <PackageReference Include="Thoth.Json.JavaScript" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true'">
    <PackageReference Include="Thoth.Json.Newtonsoft" Version="0.4.0" />
  </ItemGroup>
</Project>
