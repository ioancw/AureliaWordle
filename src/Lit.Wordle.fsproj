<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Words.fs" />
    <Compile Include="Phonics.fs" />
    <Compile Include="GameRules.fs" />
    <Compile Include="Daily.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="Game.fs" />
    <Compile Include="LocalStorage.fs" />
    <Compile Include="Components.fs" />
    <Compile Include="Modals.fs" />
    <Compile Include="App.fs" />
    <Content Include="index.css" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Lit" Version="1.4.2" />
    <PackageReference Include="Thoth.Json.Core" Version="0.7.1" />
  </ItemGroup>
  <!-- The same JSON encoders/decoders run on JavaScript in the browser and on .NET in the tests. -->
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true'">
    <PackageReference Include="Thoth.Json.JavaScript" Version="0.4.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true'">
    <PackageReference Include="Thoth.Json.Newtonsoft" Version="0.3.3" />
  </ItemGroup>
</Project>
