# Betfair API credentials
BETFAIR_USERNAME=your_username@example.com
BETFAIR_PASSWORD=your_password
BETFAIR_APP_KEY=your_app_key

# Path to the directory containing your Betfair SSL certificates
# The directory should contain client-2048.crt and client-2048.key
CERT_PATH=/etc/betfair-certs

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
